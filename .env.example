# Docker's published port. The app still uses port 3000 inside the container.
GLOVEBOX_PORT=3000

# Listen on all IPv4 interfaces; use 127.0.0.1 for local-only access.
GLOVEBOX_BIND_ADDRESS=0.0.0.0

# Allow same-origin imports/deletions from LAN devices and reverse proxies.
# The app has no authentication; protect access with your network or proxy.
MANUALS_ALLOW_REMOTE_IMPORT=1

# Updated automatically by scripts/prepare-docker.sh.
GLOVEBOX_UID=1000
GLOVEBOX_GID=1000
