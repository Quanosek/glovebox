{
  "name": "glovebox",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "initial": "node scripts/initial.mjs",
    "dev": "next dev",
    "lint": "eslint --max-warnings=0",
    "lint:py": "node scripts/run-python.mjs -m ruff check scripts",
    "typecheck": "next typegen && tsc --noEmit",
    "unused": "knip",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:extract": "node scripts/run-python.mjs -m unittest discover -s scripts/tests",
    "format": "prettier --write .",
    "icons": "node scripts/generate-icons.mjs",
    "check": "pnpm lint && pnpm lint:py && pnpm typecheck && pnpm unused && pnpm format:check && pnpm test && pnpm test:extract && pnpm build",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "next": "16.4.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9",
    "pnpm": ">=10"
  }
}
